# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
APP_URL=http://localhost:3000

# --- Sessions / Auth ---
SESSION_SECRET=
JWT_SECRET=

# --- Database (Prisma) ---
DATABASE_URL=postgresql://user:password@localhost:5432/octotocrm

# --- Redis / BullMQ (queue + worker) ---
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=            # required on Railway Redis plugin
# REDIS_TLS=false            # set to "true" if the Redis provider requires TLS
QUEUE_MAX_ATTEMPTS=5
QUEUE_RETRY_DELAY=1000
WORKER_CONCURRENCY=5

# --- Credential encryption ---
MASTER_KEY=
CREDENTIAL_ENCRYPTION_KEY=

# --- Webhook auth ---
WEBHOOK_API_KEY=
WE_TRAVEL_WEBHOOK_SECRET=

# --- Ventrata ---
VENTRATA_API_KEY=
VENTRATA_API_URL=

# --- WeTravel ---
WETRAVEL_API_BASE_URL=https://api.wetravel.com/v2
WETRAVEL_TOKEN_URL=

# --- Zoho ---
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_REDIRECT_URI=
ZOHO_DOMAIN=https://accounts.zoho.com
ZOHO_API_DOMAIN=

# --- Local tunnel (dev only) ---
NGROK_AUTHTOKEN=
