<!DOCTYPE html>
<html>
<head>
    <title>Zoho Integration</title>
    <link rel="stylesheet" href="/css/home.css">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
    <div class="">
        <%- include('navbar'); -%>
    </div>

    <main>  
        <div class="adminDashboardContainer">
            <div class="card" style="width: 100%; max-width: 650px; padding: 20px;">
                <h2 style="margin-top: 0;">Zoho CRM Integration</h2>
                
                <div style="margin: 30px 0; font-size: 1.5rem; color: #fff;">
                    <p>Connection Status: 
                        <% if (isConnected) { %>
                            <span style="color: #4CAF50; font-weight: bold; background: rgba(76, 175, 80, 0.1); padding: 5px 15px; border-radius: 20px; border: 1px solid #4CAF50;">Connected</span>
                        <% } else { %>
                            <span style="color: #f44336; font-weight: bold; background: rgba(244, 67, 54, 0.1); padding: 5px 15px; border-radius: 20px; border: 1px solid #f44336;">Not Connected</span>
                        <% } %>
                    </p>
                </div>

                <div class="buttonContainer" style="display: flex; flex-direction: column; gap: 15px; padding: 0;">
                    <% if (isConnected) { %>
                        <a class="cardButton" href="/admin/dashboard/integrations/zoho/auth" style="text-align: center; background: rgba(255,255,255,0.1); border-radius: 8px;">Reconnect Zoho CRM</a>
                    <% } else { %>
                        <a class="cardButton" href="/admin/dashboard/integrations/zoho/auth" style="text-align: center; background: #119DA4; border-radius: 8px; color: white;">Connect Zoho CRM</a>
                    <% } %>
                    <a class="cardButton" href="/admin/dashboard" style="text-align: center; background: rgba(255,255,255,0.05); border-radius: 8px; font-size: 1.2rem;">Back to Dashboard</a>
                </div>

                <% if (error) { %>
                    <div style="margin-top: 25px; padding: 15px; background: rgba(244, 67, 54, 0.2); border-radius: 8px; border: 1px solid #f44336; color: #ffcdd2;">
                        <p style="margin: 0;"><strong>Error:</strong> <%= error %></p>
                    </div>
                <% } %>

                <% if (success) { %>
                    <div style="margin-top: 25px; padding: 15px; background: rgba(76, 175, 80, 0.2); border-radius: 8px; border: 1px solid #4CAF50; color: #c8e6c9;">
                        <p style="margin: 0;"><strong>Success:</strong> Zoho connected successfully!</p>
                    </div>
                <% } %>
            </div>
        </div>
    </main>
</body>
</html>