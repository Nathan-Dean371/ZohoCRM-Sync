<!DOCTYPE html>
<html>
<head>
    <title>Admin Dashboard</title>
    <link rel="stylesheet" href="/css/home.css">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
    <div class="">
        <%- include('navbar'); -%>
    </div>

    <main>  
        <div class="adminDashboardContainer">
            <div id="adminDashboardCardContainer">
                
                    
                    <div id="usersCard" class="card">
                        <h2>Users</h2>
                        <div class="buttonContainer">
                            <a class="cardButton" href="invite/user">Invite User</a>
                            <a class="cardButton" href="dashboard/users">View Users</a>
                            <a class="cardButton" href="dashboard/user/invites">View Users invites</a>
                        </div>
                </div>
    
                    

                    <div id="integrationsCard" class="card">
                        <h2>Integrations</h2>
                        <div class="buttonContainer">
                            <a class="cardButton" href="dashboard/integrations/zoho">Zoho Integration</a>
                            <a class="cardButton" href="/admin/dashboard/integrations/wetravel">WeTravel Integration</a>
                            <a class="cardButton" href="/admin/dashboard/integrations/ventrata">Ventrata Integration</a>
                        </div>
                    </div>

                    <div id="logsCard" class="card">
                        <h2>System Logs</h2>
                        <div class="buttonContainer">
                            <a class="cardButton" href="dashboard/webhook-logs">Webhook Logs / DLQ</a>
                        </div>
                    </div>
                
            </div>
        </div>
    </main>
</body>
</html>