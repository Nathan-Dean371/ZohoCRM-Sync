<!DOCTYPE html>
<html>
<head>
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/home.css">
    <link rel="stylesheet" href="/css/admin.css">
    <style>
        .status-badge {
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 0.8em;
            font-weight: bold;
        }
        .status-success { background: #d4edda; color: #155724; }
        .status-failed { background: #f8d7da; color: #721c24; }
        .status-processing { background: #fff3cd; color: #856404; }
        .status-received { background: #e2e3e5; color: #383d41; }
        .status-retrying { background: #cce5ff; color: #004085; }
        
        table { width: 100%; border-collapse: collapse; margin-top: 20px; color: #fff; }
        th, td { padding: 12px; text-align: left; border-bottom: 1px solid #ddd; color: #fff; }
        th { color: #222; }
        tr:hover { background-color: rgba(255, 255, 255, 0.12); }
        
        .filters { margin-bottom: 20px; }
        .requeue-btn { 
            background: #007bff; color: white; border: none; padding: 5px 10px; 
            border-radius: 4px; cursor: pointer; 
        }
        .requeue-btn:disabled { background: #ccc; cursor: not-allowed; }
        
        .error-text { color: #dc3545; font-size: 0.9em; max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; cursor: pointer; }
        .error-text:hover { white-space: normal; }
        .diagnostics-text { color: #495057; font-size: 0.85em; max-width: 320px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; cursor: pointer; }
        .diagnostics-text:hover { white-space: normal; }
    </style>
</head>
<body>
    <%- include('navbar'); -%>

    <main>
        <div class="adminDashboardContainer">
            <h1>Webhook Logs & Dead Letter Queue</h1>
            
            <div class="filters">
                <form action="/admin/dashboard/webhook-logs" method="GET">
                    <label for="status">Filter by Status:</label>
                    <select name="status" id="status" onchange="this.form.submit()">
                        <option value="">All</option>
                        <option value="RECEIVED" <%= statusFilter === 'RECEIVED' ? 'selected' : '' %>>Received</option>
                        <option value="PROCESSING" <%= statusFilter === 'PROCESSING' ? 'selected' : '' %>>Processing</option>
                        <option value="SUCCESS" <%= statusFilter === 'SUCCESS' ? 'selected' : '' %>>Success</option>
                        <option value="RETRYING" <%= statusFilter === 'RETRYING' ? 'selected' : '' %>>Retrying</option>
                        <option value="FAILED" <%= statusFilter === 'FAILED' ? 'selected' : '' %>>Failed (DLQ)</option>
                    </select>
                </form>
            </div>

            <table>
                <thead>
                    <tr>
                        <th>Created At</th>
                        <th>Processed At</th>
                        <th>Status</th>
                        <th>Attempts</th>
                        <th>Failure Class</th>
                        <th>Last Error</th>
                        <th>Diagnostics</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (logs.length === 0) { %>
                        <tr><td colspan="7">No logs found.</td></tr>
                    <% } %>
                    <% logs.forEach(log => { %>
                        <tr>
                            <td><%= log.created_at ? log.created_at.toLocaleString() : '-' %></td>
                            <td><%= log.processed_at ? log.processed_at.toLocaleString() : '-' %></td>
                            <td>
                                <span class="status-badge status-<%= log.status.toLowerCase() %>">
                                    <%= log.status %>
                                </span>
                            </td>
                            <td><%= log.attempts %></td>
                            <td><%= log.failure_class || '-' %></td>
                            <td class="error-text" title="<%= log.last_error %>">
                                <%= log.last_error || '-' %>
                            </td>
                            <td class="diagnostics-text" title="<%= JSON.stringify(log.failure_diagnostics || {}) %>">
                                <%= log.failure_diagnostics ? JSON.stringify(log.failure_diagnostics) : '-' %>
                            </td>
                            <td>
                                <button class="requeue-btn" onclick="replayJob('<%= log.id %>', '<%= log.status %>')">Replay</button>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
            
            <div style="margin-top: 20px;">
                <a href="/admin/dashboard" class="cardButton">Back to Dashboard</a>
            </div>
        </div>
    </main>

    <script>
        async function replayJob(logId, status) {
            let message = 'Are you sure you want to replay this job?';
            if (status === 'SUCCESS') {
                message = 'This job was already SUCCESSFUL. Replaying it might create duplicate records in Zoho. Are you SURE you want to replay it?';
            }
            
            if (!confirm(message)) return;
            
            try {
                const response = await fetch(`/admin/dashboard/webhook-logs/${logId}/requeue`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                });
                const result = await response.json();
                if (result.success) {
                    alert('Job successfully requeued');
                    location.reload();
                } else {
                    alert('Failed to requeue job: ' + result.message);
                }
            } catch (error) {
                console.error('Error:', error);
                alert('An error occurred while requeueing the job');
            }
        }
    </script>
</body>
</html>
