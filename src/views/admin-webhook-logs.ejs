<!DOCTYPE html>
<html>
<head>
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/home.css">
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="stylesheet" href="/css/webhook-logs.css">
</head>
<body class="webhookLogsBody">
    <%- include('navbar'); -%>

    <main class="webhookLogsPage">
        <div class="webhookLogsContainer">
            <header class="webhookLogsHeader">
                <div>
                    <p class="webhookLogsEyebrow">SYSTEM ACTIVITY</p>
                    <h1>Webhook Logs</h1>
                    <p class="webhookLogsDescription">Review incoming events and replay failed jobs.</p>
                </div>
                <a href="/admin/dashboard" class="webhookBackButton">Back to Dashboard</a>
            </header>
            
            <section class="webhookFilters" aria-label="Webhook log filters">
                <div class="webhookFiltersIntro">
                    <h2>Event history</h2>
                    <p>Filter recent webhook activity by status.</p>
                </div>
                <form action="/admin/dashboard/webhook-logs" method="GET">
                    <label for="status">Status</label>
                    <select name="status" id="status" onchange="this.form.submit()">
                        <option value="">All</option>
                        <option value="RECEIVED" <%= statusFilter === 'RECEIVED' ? 'selected' : '' %>>Received</option>
                        <option value="PROCESSING" <%= statusFilter === 'PROCESSING' ? 'selected' : '' %>>Processing</option>
                        <option value="SUCCESS" <%= statusFilter === 'SUCCESS' ? 'selected' : '' %>>Success</option>
                        <option value="RETRYING" <%= statusFilter === 'RETRYING' ? 'selected' : '' %>>Retrying</option>
                        <option value="FAILED" <%= statusFilter === 'FAILED' ? 'selected' : '' %>>Failed (DLQ)</option>
                    </select>
                </form>
            </section>

            <section class="webhookTableCard" aria-label="Webhook logs">
                <div class="webhookTableScroller">
                    <table class="webhookLogsTable">
                        <thead>
                            <tr>
                                <th scope="col">Created At</th>
                                <th scope="col">Processed At</th>
                                <th scope="col">Status</th>
                                <th scope="col">Attempts</th>
                                <th scope="col">Failure Class</th>
                                <th scope="col">Last Error</th>
                                <th scope="col">Diagnostics</th>
                                <th scope="col">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (logs.length === 0) { %>
                                <tr><td class="webhookEmptyState" colspan="8">No webhook logs found.</td></tr>
                            <% } %>
                            <% logs.forEach(log => { %>
                                <tr>
                                    <td><%= log.created_at ? log.created_at.toLocaleString() : '-' %></td>
                                    <td><%= log.processed_at ? log.processed_at.toLocaleString() : '-' %></td>
                                    <td>
                                        <span class="status-badge status-<%= log.status.toLowerCase() %>">
                                            <%= log.status %>
                                        </span>
                                    </td>
                                    <td><%= log.attempts %></td>
                                    <td><%= log.failure_class || '-' %></td>
                                    <td class="error-text" title="<%= log.last_error %>">
                                        <%= log.last_error || '-' %>
                                    </td>
                                    <td class="diagnostics-text" title="<%= JSON.stringify(log.failure_diagnostics || {}) %>">
                                        <%= log.failure_diagnostics ? JSON.stringify(log.failure_diagnostics) : '-' %>
                                    </td>
                                    <td>
                                        <button class="requeue-btn" onclick="replayJob('<%= log.id %>', '<%= log.status %>')">Replay</button>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    </main>

    <script>
        async function replayJob(logId, status) {
            let message = 'Are you sure you want to replay this job?';
            if (status === 'SUCCESS') {
                message = 'This job was already SUCCESSFUL. Replaying it might create duplicate records in Zoho. Are you SURE you want to replay it?';
            }
            
            if (!confirm(message)) return;
            
            try {
                const response = await fetch(`/admin/dashboard/webhook-logs/${logId}/requeue`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
                    }
                });
                const result = await response.json();
                if (result.success) {
                    alert('Job successfully requeued');
                    location.reload();
                } else {
                    alert('Failed to requeue job: ' + result.message);
                }
            } catch (error) {
                console.error('Error:', error);
                alert('An error occurred while requeueing the job');
            }
        }
    </script>
</body>
</html>
